# RMIS — local sandbox environment
# SQLite database (absolute path; matches the sandbox global DATABASE_URL)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Auth signing secret (JWT + OTP pepper)
NEXTAUTH_SECRET=0ff11c1f69b2d8bc689565f037d3da5bf6de272c0b2653777069d01439820ca9
NEXTAUTH_URL=http://localhost:3000

# Document/file upload storage
UPLOAD_DIR=/home/z/my-project/upload

# Notifications (mock = logged to EmailLog/SmsLog tables in DB)
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock

# Staff-tier IP gate: OFF for local development (staff can sign in from any IP)
INTRANET_ENFORCEMENT=off
