# RMIS — local sandbox environment
# SQLite database (absolute path; matches the sandbox global DATABASE_URL)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Auth signing secret (JWT + OTP pepper)
NEXTAUTH_SECRET=Uv9n3wKpQ2xR7sT4vY8zB1cE5fH0jL6mN9oP3qS7rT2uW4xA
NEXTAUTH_URL=http://localhost:3000

# Document/file upload storage
UPLOAD_DIR=/home/z/my-project/upload

# ── Email delivery: MIRDC Mail Middleware (office VM) — PRODUCTION-VERIFIED ──
# The production-verified sender ported from the RMISv4.1–v4.4 deployments:
# an Express+nodemailer service on the office Windows VM. From is ALWAYS the
# office mailbox systems@mirdc.dost.gov.ph (display name = EMAIL_MIDDLEWARE_
# SYSTEM); RMIS 2.0 additionally sends Reply-To "MIRDC HR Office"
# <recruitment@mirdc.dost.gov.ph> on every message (Task 14).
# Contract: POST {URL}/sendMail { api, system, to, subject, message(html),
# text, replyTo, attachments[] } — see deploy/mirdc_middleware/index.js.
#
# SANDBOX NOTE: 10.10.120.43 is office-intranet only — unreachable from this
# sandbox, so every send logs email_logs {provider:"middleware", status:
# "failed", error:"fetch failed"} (honest, never throws; registration and
# notices are unaffected). On the office network (production deploy) the
# exact same config delivers — byte-for-byte per the verified contract.
EMAIL_PROVIDER=middleware
EMAIL_MIDDLEWARE_URL=http://10.10.120.43:3232
EMAIL_MIDDLEWARE_API_KEY=78e69d5bef243d02d0a4151a862c273f3897f5eb4fbce9ed8a2c2378aae94337
EMAIL_MIDDLEWARE_SYSTEM=DOST-MIRDC Recruitment
# Legacy alternative documented in RMISv4.4's runbook (relay contract
# /api/rmis/send + X-RMIS-Key), only if the office moves the relay:
# EMAIL_PROVIDER=gateway
# EMAIL_GATEWAY_URL=http://10.10.120.32:3232
# EMAIL_GATEWAY_KEY=78e69d5bef243d02d0a4151a862c273f3897f5eb4fbce9ed8a2c2378aae94337

# SMS notifications (mock = logged to SmsLog table in DB)
SMS_PROVIDER=mock

# Staff-tier IP gate: OFF for local development (staff can sign in from any IP)
# MUST be "on" in production.
INTRANET_ENFORCEMENT=off

# ── Official HR signature block on notice emails (interview / skills exam) ──
# Defaults live in src/lib/notify.ts; override here to re-point the signatory.
# RMIS_HR_SIGNATORY=DOLLY MARIE T. BORLADO
# RMIS_HR_SIGNATORY_POSITION=Administrative Officer IV
# RMIS_HR_DIVISION=Finance and Administrative Division
# RMIS_HR_UNIT=HRMASS-PAU
# RMIS_HR_TELEPHONE=Local 441, Tel No: 8837-0431 to 38
